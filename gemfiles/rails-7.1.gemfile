source 'https://rubygems.org'

gem 'rails', '~> 7.1.0'
gem 'sidekiq', '>= 7.3.0', require: false if RUBY_VERSION >= '2.7.0'

gem 'logtail'
gem 'logtail-rack'
# ActiveSupport passes quirks_mode to JSON.generate until 7.2.4 and 8.1, json 3 no longer accepts it
gem 'json', '< 3'

if RUBY_PLATFORM == "java"
  gem 'mime-types', '2.6.2'
end

gemspec :path => '../'
