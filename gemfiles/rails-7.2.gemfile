source 'https://rubygems.org'

# 7.2.4 is the first release that works with json 3. Without the floor, Bundler prefers
# minitest 6 over it and settles for Rails 7.2.3.
gem 'rails', '~> 7.2.4'
gem 'sidekiq', '>= 7.3.0', require: false

gem 'logtail', git: 'https://github.com/logtail/logtail-ruby.git', branch: 'claude/json-generate'
gem 'logtail-rack', git: 'https://github.com/logtail/logtail-ruby-rack.git', branch: 'claude/json-generate'

gemspec :path => '../'
